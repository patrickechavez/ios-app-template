//
//  Production.xcconfig
//  AppTemplate
//

#include "Shared.xcconfig"
#include? "Secrets.xcconfig"

// Identity
PRODUCT_BUNDLE_IDENTIFIER = com.patrick.AppTemplate
APP_DISPLAY_NAME = App Template
APP_URL_SCHEME = apptemplate

// API
API_BASE_URL = https:/$()/dummyjson.com
API_TIMEOUT_SECONDS = 30
API_MAX_RETRIES = 2
API_LOGGING_ENABLED = NO

// Force update
UPDATE_URL = itms-apps:/$()/apple.com/app/id000000000
FORCE_UPDATE_ENABLED = YES

// Add base64 SPKI hashes (see README "Hardening"), then flip this to YES.
// YES with an empty list would claim pinning while performing none.
CERT_PINNING_ENABLED = NO
PINNED_PUBLIC_KEY_HASHES =

SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) PRODUCTION
