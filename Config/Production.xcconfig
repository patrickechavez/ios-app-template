//
//  Production.xcconfig
//  AppTemplate
//
//  App Store builds. This is the only configuration real users ever run —
//  treat every value here as load-bearing.
//
//  NOTE: `//` starts a comment in xcconfig files, so URLs must escape the
//  double slash as `https:/$()/host`. The `$()` expands to nothing.
//

#include? "Secrets.xcconfig"

APP_BUNDLE_ID = com.patrick.AppTemplate
APP_DISPLAY_NAME = App Template
APP_URL_SCHEME = apptemplate

MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

API_BASE_URL = https:/$()/dummyjson.com

API_LOGGING_ENABLED = NO

API_TIMEOUT_SECONDS = 30
API_MAX_RETRIES = 2

FORCE_UPDATE_ENABLED = YES

SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) PRODUCTION
