//
//  Shared.xcconfig
//  AppTemplate
//
//  Settings common to every environment. Each environment file includes this
//  and then overrides only what actually differs, so a value lives in exactly
//  one place.
//
//  ┌─ Shared.xcconfig ──────── common defaults
//  ├─ Development.xcconfig ─── overrides for Development
//  ├─ Staging.xcconfig ─────── overrides for Staging
//  └─ Production.xcconfig ──── overrides for Production
//
//  NOTE: `//` starts a comment in xcconfig files, so URLs must escape the
//  double slash as `https:/$()/host`. The `$()` expands to nothing.

// MARK: - Identity
//
// The reverse-DNS prefix for the app. Change this ONCE per project (or run
// Scripts/bootstrap.sh) and every environment's bundle ID follows.
APP_BUNDLE_PREFIX = com.patrick
APP_BUNDLE_ID = $(APP_BUNDLE_PREFIX).$(APP_NAME)
APP_NAME = AppTemplate
APP_DISPLAY_NAME = App Template

// Custom URL scheme for deep links, e.g. apptemplate://items/42
APP_URL_SCHEME = apptemplate

// MARK: - Versioning
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

// MARK: - Networking defaults
//
// Overridden per environment where needed.
API_TIMEOUT_SECONDS = 30
API_MAX_RETRIES = 2

// Set to YES to print every request/response to the console. Never enable in
// Production — request logs contain bearer tokens.
API_LOGGING_ENABLED = NO

// MARK: - Feature flags
FORCE_UPDATE_ENABLED = YES
