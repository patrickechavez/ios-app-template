//
//  Development.xcconfig
//  AppTemplate
//
//  Day-to-day local builds. Installs alongside Staging and Production
//  because the bundle ID and display name differ.
//

#include "Shared.xcconfig"
#include? "Secrets.xcconfig"

// Identity
PRODUCT_BUNDLE_IDENTIFIER = com.patrick.AppTemplate.dev
APP_DISPLAY_NAME = Development
APP_URL_SCHEME = apptemplate

// API — short timeout and no retries so failures surface fast
API_BASE_URL = https:/$()/dummyjson.com
API_TIMEOUT_SECONDS = 20
API_MAX_RETRIES = 0
API_LOGGING_ENABLED = YES

// Force update
UPDATE_URL = itms-apps:/$()/apple.com/app/id000000000
FORCE_UPDATE_ENABLED = YES

// Pinning off so local proxies (Charles, Proxyman) and self-signed certs work
CERT_PINNING_ENABLED = NO
PINNED_PUBLIC_KEY_HASHES =

SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) DEVELOPMENT
