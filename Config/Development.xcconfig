//
//  Development.xcconfig
//  AppTemplate
//
//  Local / day-to-day development builds. Installs alongside Staging and
//  Production because the bundle ID and display name are suffixed.
//

#include "Shared.xcconfig"

// MARK: - Identity
// The `.dev` suffix lets all three environments coexist on one device.
APP_BUNDLE_ID = $(APP_BUNDLE_PREFIX).$(APP_NAME).dev
APP_DISPLAY_NAME = AppTemplate Dev
APP_URL_SCHEME = apptemplate-dev

// MARK: - API
//
// REPLACE THIS with your development API. The template ships pointing at a
// public sample API so a fresh clone runs without a backend.
API_BASE_URL = https:/$()/dummyjson.com

// Verbose request/response logging is safe here and saves a lot of time.
API_LOGGING_ENABLED = YES

// Fail fast locally instead of masking a slow endpoint with retries.
API_TIMEOUT_SECONDS = 20
API_MAX_RETRIES = 0

// MARK: - Build
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) DEVELOPMENT
