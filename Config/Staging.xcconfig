//
//  Staging.xcconfig
//  AppTemplate
//
//  Pre-production builds for QA and internal distribution (TestFlight).
//  Release-optimized, but still pointed at the staging backend.
//
//  NOTE: `//` starts a comment in xcconfig files, so URLs must escape the
//  double slash as `https:/$()/host`. The `$()` expands to nothing.
//

#include? "Secrets.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = com.patrick.AppTemplate.staging
APP_DISPLAY_NAME = App Template Staging
APP_URL_SCHEME = apptemplate

MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

API_BASE_URL = https:/$()/dummyjson.com

UPDATE_URL = itms-apps:/$()/apple.com/app/id000000000

API_LOGGING_ENABLED = NO

API_TIMEOUT_SECONDS = 30
API_MAX_RETRIES = 2

FORCE_UPDATE_ENABLED = YES

// Certificate pinning is off for staging so test/QA environments aren't broken
// by cert rotations mid-release.
CERT_PINNING_ENABLED = NO
PINNED_PUBLIC_KEY_HASHES =

SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) STAGING
